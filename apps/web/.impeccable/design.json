    "typographyMeta": {
      "display": {
        "displayName": "Display",
        "purpose": "The focus timer only. 4.5rem, 7.5rem from 1280px wide; calm mode has its own step."
      },
      "numeral-lg": {
        "displayName": "Numeral Large",
        "purpose": "A timer inside a card (the tracker). 56px, weight 300, tabular; 48px below 1024px."
      },
      "numeral": {
        "displayName": "Numeral",
        "purpose": "The one big number of a card. 40px, weight 300, tabular; its unit is half the size. 36px below 1024px."
      },
      "headline": {
        "displayName": "Headline",
        "purpose": "The page h1. 32px, weight 500."
      },
      "figure": {
        "displayName": "Figure",
        "purpose": "A number in a row of figures over its 13px label. 28px, weight 300, tabular."
      },
      "title-lg": {
        "displayName": "Title Large",
        "purpose": "Dialog titles, a block title. 22px, weight 500."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Section headings and settings legends. 18px, weight 500."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Running text, fields, a card title (at 500). 16px, line-height 1.6 for Hangul."
      },
      "body-sm": {
        "displayName": "Body Small",
        "purpose": "Buttons, nav items, tables, meta lines. 14px (15px below 1024px)."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Field labels, tags, captions. 13px, weight 500."
      },
      "grid-label": {
        "displayName": "Grid Label",
        "purpose": "Chart ticks, key caps, the bottom nav. 12px. Not for running text."
      },
      "code": {
        "displayName": "Code",
        "purpose": "Only where the content is code: an RRULE, a raw-input field, inline code in a note."
      }
    },
