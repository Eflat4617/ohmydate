  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one lime-filled control of a view or dialog: the next thing to do. Inert, it gives the lime back.",
      "html": "<button class=\"ds-btn ds-btn-primary\">집중 시작</button> <button class=\"ds-btn ds-btn-primary\" disabled>집중 시작</button>",
      "css": ".ds-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 2.5rem; padding: 0 1rem; border: 1px solid oklch(96% 0.005 150 / 17%); border-radius: 10px; background: transparent; color: oklch(96% 0.005 150); font-family: 'Pretendard Variable', Pretendard, 'Noto Sans CJK KR', 'Noto Sans KR', system-ui, sans-serif; font-size: 0.875rem; font-weight: 500; line-height: 1.2; white-space: nowrap; cursor: pointer; } .ds-btn-primary { border-color: transparent; background: oklch(89% 0.2 128); color: oklch(17% 0.03 140); font-weight: 600; } .ds-btn-primary:hover { background: oklch(93% 0.18 128); } .ds-btn-primary:disabled { background: oklch(23.5% 0.011 150); color: oklch(83% 0.008 150); opacity: 0.7; cursor: not-allowed; }"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button",
      "description": "The default: transparent with a strong hairline. Ghost drops the edge.",
      "html": "<button class=\"ds-btn\">축소</button> <button class=\"ds-btn ds-btn-ghost\">취소</button>",
      "css": ".ds-btn-ghost { border-color: transparent; } .ds-btn:hover { background: oklch(96% 0.005 150 / 6%); }"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "The unit: a surface with a hairline edge, 20px corners and, in the dark scheme, a faint top-left sheen. A small title, one big light number, then a chart or a list.",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">진행</h2><p class=\"ds-numeral\">6<span>시간</span> 38<span>분</span></p><p class=\"ds-caption\">이번 주 집중 시간</p></section>",
      "css": ".ds-card { display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem; border: 1px solid oklch(96% 0.005 150 / 9%); border-radius: 20px; background: linear-gradient(140deg, oklch(96% 0.005 150 / 5%), transparent 42%) oklch(17.5% 0.009 150); font-family: 'Pretendard Variable', Pretendard, 'Noto Sans CJK KR', 'Noto Sans KR', system-ui, sans-serif; } .ds-card-title { margin: 0; color: oklch(96% 0.005 150); font-size: 1rem; font-weight: 500; } .ds-numeral { margin: 0; color: oklch(96% 0.005 150); font-size: 2.5rem; font-weight: 300; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; line-height: 1.05; } .ds-numeral span { margin-left: 0.12em; color: oklch(83% 0.008 150); font-size: 0.5em; letter-spacing: 0; } .ds-caption { margin: 0; color: oklch(69% 0.01 150); font-size: 0.8125rem; }"
    },
    {
      "name": "Tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "A small rounded rectangle with a tinted fill and matching text; one hue per category. The word carries the state.",
      "html": "<span class=\"ds-tag\">할 일</span> <span class=\"ds-tag ds-tag-lime\">다음 차례</span> <span class=\"ds-tag ds-tag-green\">완료</span> <span class=\"ds-tag ds-tag-amber\">주의</span> <span class=\"ds-tag ds-tag-red\">지났어요</span> <span class=\"ds-tag ds-tag-cyan\">졸업 논문</span>",
      "css": ".ds-tag { display: inline-flex; align-items: center; min-height: 1.5rem; padding: 0 0.5rem; border-radius: 6px; background: oklch(23.5% 0.011 150); color: oklch(83% 0.008 150); font-family: 'Pretendard Variable', Pretendard, 'Noto Sans CJK KR', 'Noto Sans KR', system-ui, sans-serif; font-size: 0.8125rem; font-weight: 500; white-space: nowrap; } .ds-tag-lime { background: oklch(89% 0.2 128 / 14%); color: oklch(89% 0.2 128); } .ds-tag-green { background: oklch(82% 0.15 158 / 14%); color: oklch(84% 0.15 158); } .ds-tag-amber { background: oklch(85% 0.14 85 / 14%); color: oklch(87% 0.14 85); } .ds-tag-red { background: oklch(69% 0.19 25 / 18%); color: oklch(78% 0.12 22); } .ds-tag-cyan { background: oklch(87% 0.12 195 / 14%); color: oklch(87% 0.12 195); }"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Field, select and textarea are one box: an inset well with the 3:1 control edge.",
      "html": "<label class=\"ds-field\"><span>작업 제목</span><input class=\"ds-input\" placeholder=\"무엇을 해야 하나요?\" /></label>",
      "css": ".ds-field { display: flex; flex-direction: column; gap: 0.375rem; color: oklch(96% 0.005 150); font-family: 'Pretendard Variable', Pretendard, 'Noto Sans CJK KR', 'Noto Sans KR', system-ui, sans-serif; font-size: 0.8125rem; font-weight: 500; } .ds-input { min-height: 2.5rem; padding: 0.375rem 0.75rem; border: 1px solid oklch(52% 0.012 150); border-radius: 10px; background: oklch(11.5% 0.006 150); color: oklch(96% 0.005 150); font: inherit; font-size: 1rem; font-weight: 400; } .ds-input:focus-visible { border-color: oklch(89% 0.2 128); outline: 2px solid oklch(89% 0.2 128); outline-offset: -1px; }"
    },
    {
      "name": "Segmented Control",
      "kind": "navigation",
      "refersTo": "button",
      "description": "One of a few, in an inset track; the picked one is a lifted, heavier tile (the theme switch).",
      "html": "<div class=\"ds-seg\" role=\"group\" aria-label=\"테마\"><button class=\"ds-seg-item\" aria-pressed=\"false\">라이트</button><button class=\"ds-seg-item\" aria-pressed=\"true\">다크</button><button class=\"ds-seg-item\" aria-pressed=\"false\">시스템</button></div>",
      "css": ".ds-seg { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid oklch(96% 0.005 150 / 17%); border-radius: 10px; background: oklch(11.5% 0.006 150); } .ds-seg-item { min-height: 2.125rem; padding: 0 0.75rem; border: 1px solid transparent; border-radius: 7px; background: transparent; color: oklch(69% 0.01 150); font-family: 'Pretendard Variable', Pretendard, 'Noto Sans CJK KR', 'Noto Sans KR', system-ui, sans-serif; font-size: 0.8125rem; cursor: pointer; } .ds-seg-item[aria-pressed='true'] { border-color: oklch(96% 0.005 150 / 17%); background: oklch(28% 0.012 150); color: oklch(96% 0.005 150); font-weight: 600; }"
    },
    {
      "name": "Sidebar Item",
      "kind": "navigation",
      "refersTo": "nav-link",
      "description": "The current screen takes the lime-to-cyan gradient with dark text and aria-current; no other item is filled.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link\" aria-current=\"page\" href=\"#\">개요</a><a class=\"ds-nav-link\" href=\"#\">오늘</a><a class=\"ds-nav-link\" href=\"#\">한달</a></nav>",
      "css": ".ds-nav { display: flex; flex-direction: column; gap: 2px; width: 13.5rem; font-family: 'Pretendard Variable', Pretendard, 'Noto Sans CJK KR', 'Noto Sans KR', system-ui, sans-serif; } .ds-nav-link { display: flex; align-items: center; min-height: 2.125rem; padding: 0 0.75rem; border-radius: 10px; color: oklch(83% 0.008 150); font-size: 0.875rem; text-decoration: none; } .ds-nav-link:hover { background: oklch(96% 0.005 150 / 6%); } .ds-nav-link[aria-current='page'] { background: linear-gradient(100deg, oklch(89% 0.2 128), oklch(87% 0.12 195)); color: oklch(17% 0.03 140); font-weight: 600; }"
    },
    {
      "name": "Banner",
      "kind": "feedback",
      "refersTo": "banner",
      "description": "A tinted line with its hue on the edge; text stays the page text. Error is red with a red title; offline is neutral and dashed.",
      "html": "<p class=\"ds-banner\">재계획 제안 1개가 기다리고 있어요</p> <p class=\"ds-banner ds-banner-error\">오늘 일정을 불러오지 못했어요.</p>",
      "css": ".ds-banner { margin: 0 0 0.5rem; padding: 0.75rem 1rem; border: 1px solid oklch(84% 0.09 235 / 32%); border-radius: 14px; background: oklch(81% 0.1 235 / 16%); color: oklch(96% 0.005 150); font-family: 'Pretendard Variable', Pretendard, 'Noto Sans CJK KR', 'Noto Sans KR', system-ui, sans-serif; font-size: 0.875rem; } .ds-banner-error { border-color: oklch(78% 0.12 22 / 32%); background: oklch(69% 0.19 25 / 18%); }"
    },
    {
      "name": "Bar Set",
      "kind": "chart",
      "refersTo": "card",
      "description": "A week of days on one scale; today is the lime bar. Zero is an empty track, a day that has not come is dashed. The numbers are also a hidden table.",
      "html": "<div class=\"ds-bars\"><i style=\"--v:40%\"></i><i style=\"--v:62%\"></i><i style=\"--v:18%\"></i><i style=\"--v:70%\"></i><i style=\"--v:48%\"></i><i class=\"ds-bar-today\" style=\"--v:100%\"></i><i class=\"ds-bar-future\"></i></div>",
      "css": ".ds-bars { display: flex; align-items: flex-end; justify-content: space-around; height: 8rem; } .ds-bars i { position: relative; width: 10px; height: 100%; border-radius: 999px; background: oklch(96% 0.005 150 / 10%); } .ds-bars i::after { content: ''; position: absolute; inset: auto 0 0; height: var(--v, 0%); border-radius: 999px; background: oklch(96% 0.005 150); } .ds-bars .ds-bar-today::after { background: oklch(89% 0.2 128); } .ds-bars .ds-bar-future { background: none; outline: 1px dashed oklch(96% 0.005 150 / 17%); }"
    },
