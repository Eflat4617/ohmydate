{
  "name": "@ohmydate/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "gen:api": "node scripts/generate-api.mjs",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=4 --exclude \"test/owner-switch-sweep.shard-*.spec.ts\" && vitest run --maxWorkers=4 test/owner-switch-sweep.shard-",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ohmydate/ui-policy": "workspace:*",
    "@tanstack/vue-query": "5.107.1",
    "markdown-it": "15.0.3",
    "openapi-fetch": "0.17.0",
    "pinia": "3.0.4",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "fake-indexeddb": "6.2.8",
    "jsdom": "27.4.0",
    "msw": "3.0.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
