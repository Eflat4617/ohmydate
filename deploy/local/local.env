# GU-1 local run package — committed, NON-secret configuration.
# Secrets live only in deploy/secrets/local/postgres.env and vikunja.env (generated, gitignored).
# All services bind to 127.0.0.1.

# Ports (compose uses POSTGRES_PORT / VIKUNJA_PORT, start.mjs uses API_PORT / WEB_PORT).
POSTGRES_PORT=55442
VIKUNJA_PORT=3466
API_PORT=3100
WEB_PORT=5180

HOST=127.0.0.1
NODE_ENV=production

# ADR-022 defaults (services/api/src/config.ts). Override via process env if needed.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_REASONING_EFFORT=medium

# Default is <repo root>/deepseek_api_key.txt; a relative value resolves against
# the repo root, and LLM_API_KEY_FILE in the process environment wins.
LLM_API_KEY_FILE=deepseek_api_key.txt

# Conservative ADR-022 budget defaults.
LLM_DAILY_BUDGET_USD=0.2
LLM_MONTHLY_BUDGET_USD=5
