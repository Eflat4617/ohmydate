{
  "$id": "llm.commitment_parse.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "leftover"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 10,
      "examples": [
        [
          {
            "title": "title",
            "date": "2026-01-02",
            "startTime": "15:00",
            "endTime": null,
            "endDate": null,
            "weeklyDays": null,
            "untilDate": null,
            "dateWasGuessed": false
          }
        ]
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "date",
          "startTime",
          "endTime",
          "endDate",
          "weeklyDays",
          "untilDate",
          "dateWasGuessed"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "startTime": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
              { "type": "null" }
            ]
          },
          "endTime": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
              { "type": "null" }
            ]
          },
          "endDate": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              { "type": "null" }
            ]
          },
          "weeklyDays": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "items": { "enum": ["MO", "TU", "WE", "TH", "FR", "SA", "SU"] }
              },
              { "type": "null" }
            ]
          },
          "untilDate": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              { "type": "null" }
            ]
          },
          "dateWasGuessed": {
            "type": "boolean"
          }
        }
      }
    },
    "leftover": {
      "type": "string",
      "maxLength": 500,
      "examples": [""]
    }
  }
}
