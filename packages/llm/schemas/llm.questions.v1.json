{
  "$id": "llm.questions.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions"],
  "properties": {
    "questions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "question"],
        "properties": {
          "field": {
            "enum": [
              "deliverable",
              "dueAt",
              "estimatedScope",
              "currentProgress",
              "availabilityConfirmed",
              "prerequisites",
              "priority",
              "maxFocusMinutes",
              "reviewNeeded"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    }
  }
}
