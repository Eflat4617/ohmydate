{
  "$id": "llm.layout_suggestion.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "regions",
    "pinned",
    "reason",
    "policyVersion"
  ],
  "properties": {
    "mode": {
      "enum": [
        "overview",
        "planning",
        "focus",
        "deadline_risk",
        "review",
        "notes"
      ]
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "secondary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "tertiary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "pinned": {
      "type": "array",
      "items": {
        "enum": [
          "FocusTimer",
          "CurrentTaskCard",
          "RelatedNotes",
          "NextUp",
          "NavRail",
          "BottomNav"
        ]
      }
    },
    "reason": {
      "type": "string",
      "maxLength": 200
    },
    "policyVersion": {
      "type": "string",
      "maxLength": 80
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "enum": [
            "FocusTimer",
            "CurrentTaskCard",
            "RelatedNotes",
            "NextUp",
            "NavRail",
            "BottomNav"
          ]
        },
        "props": {
          "type": "object",
          "description": "Non-string scalar props only until per-component prop schemas exist; ui-policy re-validates.",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "description": "Structural validation only. packages/ui-policy re-validates the component allowlist and per-component prop schemas before rendering; prop values are limited to non-string scalars here."
}
