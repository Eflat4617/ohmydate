{
  "$id": "llm.layout_suggestion.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "regions",
    "pinned",
    "reason",
    "policyVersion"
  ],
  "properties": {
    "mode": {
      "enum": [
        "overview",
        "planning",
        "focus",
        "deadline_risk",
        "review",
        "notes"
      ]
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary"
      ],
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "secondary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "tertiary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      }
    },
    "pinned": {
      "type": "array",
      "items": {
        "enum": [
          "FocusTimer",
          "CurrentTaskCard",
          "RelatedNotes",
          "NextUp",
          "NavRail",
          "BottomNav"
        ]
      }
    },
    "reason": {
      "type": "string",
      "maxLength": 200
    },
    "policyVersion": {
      "type": "string",
      "maxLength": 80
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component"
      ],
      "properties": {
        "component": {
          "enum": [
            "FocusTimer",
            "CurrentTaskCard",
            "RelatedNotes",
            "NextUp",
            "NavRail",
            "BottomNav"
          ]
        },
        "props": {
          "type": "object",
          "description": "Non-string scalars plus UUID-valued sessionId/taskId/documentId; ui-policy re-validates.",
          "properties": {
            "sessionId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "taskId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "documentId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9]{0,40}$"
          }
        }
      }
    }
  },
  "description": "Structural validation only. packages/ui-policy re-validates the component allowlist and per-component prop schemas before rendering. Props allow numbers/booleans/null plus id-like string props (sessionId, taskId, documentId) constrained to UUIDs."
}
