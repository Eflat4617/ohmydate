{
  "$id": "llm.task_parse.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["items", "leftover"],
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 10,
      "examples": [
        [
          {
            "title": "title",
            "dueDate": "2026-01-02",
            "dueTime": null,
            "dateWasGuessed": false,
            "meridiemWasGuessed": false
          }
        ]
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "dueDate", "dueTime", "dateWasGuessed", "meridiemWasGuessed"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "dueDate": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              { "type": "null" }
            ]
          },
          "dueTime": {
            "anyOf": [
              { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
              { "type": "null" }
            ]
          },
          "dateWasGuessed": {
            "type": "boolean"
          },
          "meridiemWasGuessed": {
            "type": "boolean"
          }
        }
      }
    },
    "leftover": {
      "type": "string",
      "maxLength": 500,
      "examples": [""]
    }
  }
}
