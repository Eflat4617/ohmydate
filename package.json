{
  "name": "ohmydate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p e2e",
    "lint": "eslint .",
    "test": "vitest run && pnpm --filter @ohmydate/web test",
    "check:api-client": "pnpm --filter @ohmydate/web gen:api && git diff --exit-code apps/web/src/api/schema.d.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "smoke:build": "node scripts/ci/build-smoke.mjs",
    "local:setup": "node scripts/local/setup.mjs",
    "local:start": "node scripts/local/start.mjs",
    "local:stop": "node scripts/local/stop.mjs",
    "local:status": "node scripts/local/status.mjs",
    "test:local": "OHMYDATE_LOCAL_SMOKE=1 vitest run --config scripts/local/vitest.config.mjs",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run check:api-client && pnpm run check:boundaries && node scripts/ci/build-smoke.mjs --required"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  }
}
